        "_"
      ],
      "widths": [
        [
          4,
          4
        ],
        [
          5,
          5
        ]
      ],
      "expectHit": false
    },
    {
      "name": "star closer before NUL is closing",
      "source": "{run}alpha{endRun}\u0000",
      "markers": [
        "*"
      ],
      "widths": [
        [
          4,
          4
        ],
        [
          5,
          5
        ]
      ],
      "expectHit": true
    },
    {
      "name": "underscore closer before NUL is closing",
      "source": "{run}alpha{endRun}\u0000",
      "markers": [
        "_"
      ],
      "widths": [
        [
          4,
          4
        ],
        [
          5,
          5
        ]
      ],
      "expectHit": true
    },
    {
      "name": "below batch threshold",
      "source": "{run}alpha{endRun}",
      "widths": [
        [
          1,
          1
        ],
        [
          2,
          2
        ],
        [
          3,
          3
        ]
      ],
      "expectHit": false
    },
    {
      "name": "different raw markers",
      "source": "****alpha____",
      "expectHit": false
    },
    {
      "name": "third raw marker",
      "source": "****alpha *beta* gamma****",
      "expectHit": false
    },
    {
      "name": "underscore closer before ASCII word is not closing",
      "source": "{run}alpha{endRun}z",
      "markers": [
        "_"
      ],
      "widths": [
        [
          4,
          4
        ],
        [
          5,
          5
        ]
      ],
      "expectHit": false
    },
    {
      "name": "star closer before ASCII word is two-way",
      "source": "{run}alpha{endRun}z",
      "markers": [
        "*"
      ],
      "widths": [
        [
          4,
          4
        ],
        [
          5,
          5
        ]
      ],
      "expectHit": true
    }
  ]
}
