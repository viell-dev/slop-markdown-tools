{
  "name": "mdrefine",
  "version": "0.4.0",
  "description": "Configurable Markdown linting and formatting for CommonMark, GitHub, Forgejo, Gitea, Obsidian, and VitePress",
  "keywords": [
    "markdown",
    "lint",
    "linter",
    "format",
    "formatter",
    "commonmark",
    "gfm",
    "github",
    "forgejo",
    "codeberg",
    "gitea",
    "obsidian",
    "vitepress",
    "mdast",
    "micromark"
  ],
  "type": "module",
  "license": "MIT",
  "author": "viell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viell-dev/slop-markdown-tools.git"
  },
  "bugs": {
    "url": "https://github.com/viell-dev/slop-markdown-tools/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "mdtools": "dist/cli/main.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./config.schema.json": "./config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.schema.json",
    "docs/*.md",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "node scripts/build-parser.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "npm run build",
    "test:unit": "vitest run --project unit",
    "test:performance": "vitest run --project performance",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "pretest:integration": "npm run build",
    "test:package": "run-s build test:package:installed",
    "lint": "eslint .",
    "format": "run-s format:code format:docs",
    "format:code": "prettier --write .",
    "format:docs": "run-s build format:docs:write",
    "format:docs:check": "run-s build lint:docs format:docs:verify",
    "format:check": "run-p format:code:check format:docs:check",
    "check": "npm-run-all --parallel typecheck lint format:check docs:build --sequential test",
    "prepack": "npm run build",
    "test:package:installed": "node scripts/package-smoke.mjs",
    "format:docs:write": "node dist/cli/main.js format --write",
    "lint:docs": "node dist/cli/main.js lint --max-warnings 0",
    "format:docs:verify": "node dist/cli/main.js format --check",
    "format:code:check": "prettier --check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "benchmark": "node benchmarks/run.mjs",
    "prebenchmark": "npm run build",
    "check:obsidian": "run-s build check:obsidian:run",
    "check:obsidian:run": "node scripts/obsidian-check.mjs",
    "check:live": "node scripts/check-live.mjs",
    "release:prepare": "run-s check release:pack",
    "release:pack": "node scripts/package-smoke.mjs --retain",
    "schema": "run-s build schema:write",
    "schema:write": "node scripts/config-schema.mjs"
  },
  "dependencies": {
    "@mdit-vue/plugin-component": "3.0.2",
    "@mdit/plugin-attrs": "1.3.3",
    "@mdit/plugin-container": "1.0.2",
    "@mdit/plugin-emoji": "1.1.1",
    "@mdit/plugin-footnote": "1.0.2",
    "@mdit/plugin-tasklist": "1.0.2",
    "@types/mdast": "4.0.4",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "cross-spawn": "7.0.6",
    "decode-named-character-reference": "1.3.0",
    "diff": "9.0.0",
    "entities": "8.1.0",
    "github-slugger": "2.0.0",
    "ignore": "7.0.12",
    "import-meta-resolve": "4.2.0",
    "jsonc-parser": "3.3.1",
    "markdown-it": "14.3.3",
    "markdown-it-cjk-friendly": "2.0.2",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "mdast-util-math": "3.0.0",
    "micromark-extension-cjk-friendly": "2.0.2",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "micromark-factory-space": "2.1.0",
    "micromark-util-character": "2.1.1",
    "micromark-util-types": "2.0.3",
    "minimatch": "10.2.6",
    "string-width": "8.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/commonmark": "0.27.10",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.20.5",
    "@types/unist": "3.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "commonmark": "0.31.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "hast-util-to-html": "9.0.5",
    "markdown-it-mathjax3": "4.3.2",
    "mdast-util-to-hast": "13.2.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.5"
  },
  "overrides": {
    "speech-rule-engine@4.1.4": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "homepage": "https://viell-dev.github.io/slop-markdown-tools/"
}
